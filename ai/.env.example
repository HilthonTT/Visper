# Copy to .env (read from the current working directory) and adjust.
# Real environment variables override values in .env.

# App
ENVIRONMENT=local                # local | staging | production (docs disabled in production)
APP_HOST=0.0.0.0
APP_PORT=8088                    # the Go api-sdk defaults to http://localhost:8088 (VISPER_AI_BASE_URL)
# APP_NAME=Visper AI
# LICENSE_NAME=MIT

# Redis - sessions written by the Go API are read from <REDIS_KEY_PREFIX>user:<id>
REDIS_KEY_PREFIX=visper:
REDIS_CACHE_HOST=localhost
REDIS_CACHE_PORT=6379
REDIS_CACHE_PASSWORD=

REDIS_QUEUE_HOST=localhost
REDIS_QUEUE_PORT=6379
REDIS_QUEUE_PASSWORD=

REDIS_RATE_LIMIT_HOST=localhost
REDIS_RATE_LIMIT_PORT=6379
REDIS_RATE_LIMIT_PASSWORD=

# Rate limiting (requests per period, per user and path)
DEFAULT_RATE_LIMIT_LIMIT=10
DEFAULT_RATE_LIMIT_PERIOD=3600
# GUEST_RATE_LIMIT_LIMIT=5       # default: DEFAULT_RATE_LIMIT_LIMIT / 2
# ANONYMOUS_RATE_LIMIT_LIMIT=2   # default: DEFAULT_RATE_LIMIT_LIMIT / 4

# Ollama
OLLAMA_HOST=localhost
OLLAMA_PORT=11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=120               # seconds, per read/write (generation)
OLLAMA_CONNECT_TIMEOUT=5
OLLAMA_MAX_TOKENS=500
OLLAMA_TEMPERATURE=0.7

# Enhancement
ENHANCEMENT_CACHE_TTL=3600
MAX_MESSAGE_LENGTH=2000
MIN_MESSAGE_LENGTH=3
BATCH_SIZE_LIMIT=5
ENABLE_RULE_BASED_FALLBACK=true

# CORS (JSON lists). Credentials are only allowed when origins are explicit (no "*").
CORS_ORIGINS=["*"]
# CORS_METHODS=["*"]
# CORS_HEADERS=["*"]

# Client-side Cache-Control max-age for GET responses
CLIENT_CACHE_MAX_AGE=60

# Logging
CONSOLE_LOG_LEVEL=INFO
CONSOLE_LOG_FORMAT_JSON=false
FILE_LOG_ENABLED=true
LOG_DIR=logs                     # relative to the working directory
FILE_LOG_LEVEL=INFO
FILE_LOG_FORMAT_JSON=true
