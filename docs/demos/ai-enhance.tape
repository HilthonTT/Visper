# Rewrite a draft with the local LLM (Ollama). Rendered by docs/demos/record.sh.
Output docs/assets/demos/ai-enhance.gif

Set Shell bash
Set FontSize 16
Set Width 1280
Set Height 760
Set Padding 16
Set Theme "Catppuccin Mocha"
Set TypingSpeed 45ms
Set Framerate 24

Hide
Type "clear && visper" Enter
Sleep 3.5s
Show

Type "j"
Sleep 600ms
Type "{{JOIN_CODE_SILENT}}"
Enter
Sleep 2.5s

Type "hey can u send me the notes from the meeting pls"
Sleep 800ms
Ctrl+A
Sleep 10s
Enter
Sleep 2.5s
