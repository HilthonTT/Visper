# Share an image; it previews inline in the terminal. Rendered by docs/demos/record.sh.
Output docs/assets/demos/file-share.gif

Set Shell bash
Set FontSize 16
Set Width 1280
Set Height 760
Set Padding 16
Set Theme "Catppuccin Mocha"
Set TypingSpeed 45ms
Set Framerate 24

Hide
Type "clear && visper" Enter
Sleep 3.5s
Show

Type "j"
Sleep 600ms
Type "{{JOIN_CODE_SILENT}}"
Enter
Sleep 2.5s

# The explorer starts in $HOME (record.sh puts two images in ~/Pictures).
Ctrl+U
Sleep 1.5s
Down
Sleep 700ms
Enter
Sleep 1.2s
Down
Sleep 700ms
Down
Sleep 900ms
Enter
Sleep 6s
