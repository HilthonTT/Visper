# Menu, FAQ and settings. Rendered by docs/demos/record.sh.
Output docs/assets/demos/tour.gif

Set Shell bash
Set FontSize 16
Set Width 1280
Set Height 760
Set Padding 16
Set Theme "Catppuccin Mocha"
Set TypingSpeed 45ms
Set Framerate 24

Hide
Type "clear && visper" Enter
Sleep 3.5s
Show

# Menu -> FAQ, then left/right move between the tabs at the top.
Sleep 1.5s
Type "f"
Sleep 3.5s
Right
Sleep 2s
# Settings: pick the chat sidebar image.
Type "2"
Sleep 2s
Type "1"
Sleep 1.5s
Escape
Sleep 1.5s
