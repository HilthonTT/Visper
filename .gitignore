# ── OS / editors ─────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
*.swp

# ── Secrets ──────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Logs ─────────────────────────────────────────────────────
*.log
logs/

# ── Go ───────────────────────────────────────────────────────
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
coverage.*
*.coverprofile
profile.cov
bin/
tmp/
dist/

# ── API runtime data ─────────────────────────────────────────
api/infrastructure/config/config-development.yml
api/data/
api/uploads/
api/cmd/**/data/
api/cmd/**/uploads/

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
ai/env/
ai/models/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# ── Web ──────────────────────────────────────────────────────
node_modules/
web/dist/
web/.tanstack/
web/.output/
web/.vinxi/

# ── Media dropped into the repo by accident ──────────────────
# (tracked assets such as the CLI waifu embeds and web/public icons are
#  explicitly re-included below)
*.jpg
*.jpeg
*.gif
*.png
!cli/**/embeds/*.png
!web/public/*.png
