# ── OS / editors ─────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
*.swp

# ── Secrets ──────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Logs ─────────────────────────────────────────────────────
*.log
logs/

# ── Go ───────────────────────────────────────────────────────
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
coverage.*
*.coverprofile
profile.cov
bin/
tmp/
dist/

# ── API runtime data ─────────────────────────────────────────
services/api/data/
services/api/uploads/
services/api/cmd/**/data/
services/api/cmd/**/uploads/

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
services/ai/env/
services/ai/models/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# ── Web ──────────────────────────────────────────────────────
node_modules/
clients/web/dist/
clients/web/.tanstack/
clients/web/.output/
clients/web/.vinxi/

# ── Media dropped into the repo by accident ──────────────────
# (tracked assets such as the CLI waifu embeds and web/public icons are
#  explicitly re-included below)
*.jpg
*.jpeg
*.gif
*.png
!clients/cli/**/embeds/*.png
!clients/web/public/*.png
