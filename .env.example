# Copy to .env and adjust. Used by docker-compose.yml, which has no default
# passwords of its own: it won't start until POSTGRES_PASSWORD and
# REDIS_PASSWORD are set. These are development values only: change them for
# any real deployment.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin
POSTGRES_DB=visper_db

REDIS_PASSWORD=password

OLLAMA_MODEL=qwen2.5:3b

# Address the proxy (port 5004) is published on. Every other service is on
# 127.0.0.1 only. Use 0.0.0.0 to serve the proxy to the network.
# PROXY_BIND_ADDR=127.0.0.1
