# Visper proxy configuration. Every value is optional; defaults shown.
# Command-line flags override env vars; a JSON file (-config / PROXY_CONFIG)
# overrides the load-balancer settings below.

# --- Load balancer ---
PROXY_LISTEN_ADDR=:5004
# Comma-separated backend URLs (the api listens on 5005).
PROXY_BACKENDS=http://localhost:5005
# round_robin | least_connections | ip_hash | random | weighted_round_robin
PROXY_STRATEGY=round_robin
PROXY_HEALTH_CHECK_INTERVAL=30s
PROXY_HEALTH_CHECK_PATH=/health
PROXY_MAX_FAIL_COUNT=3
PROXY_CONFIG=

# --- HTTP server ---
PROXY_READ_HEADER_TIMEOUT=10s
PROXY_READ_TIMEOUT=60s
PROXY_WRITE_TIMEOUT=60s
PROXY_IDLE_TIMEOUT=120s
PROXY_SHUTDOWN_TIMEOUT=15s

# --- Client IP / security ---
# CIDRs or IPs of proxies in front of this one whose X-Forwarded-For is trusted.
# Leave empty when clients connect directly.
PROXY_TRUSTED_PROXIES=
# Bearer token for POST /admin/reload. Empty disables the endpoint.
PROXY_ADMIN_TOKEN=

# --- Throttling ---
PROXY_THROTTLE_GLOBAL_MAX=10000
PROXY_THROTTLE_IP_MAX=100
PROXY_THROTTLE_INTERVAL=1m
PROXY_THROTTLE_SPANS=6
PROXY_THROTTLE_COOLDOWN=30s

# --- Redis Sentinel (distributed throttling). Empty = local-only throttling ---
# Local docker-compose values:
#REDIS_SENTINEL_ADDRS=127.0.0.1:36379,127.0.0.1:36380,127.0.0.1:36381
#REDIS_DIAL_LOCALHOST=true
#REDIS_PASSWORD=password
#REDIS_SENTINEL_PASSWORD=password
REDIS_SENTINEL_ADDRS=
REDIS_MASTER_NAME=mymaster
REDIS_PASSWORD=
REDIS_SENTINEL_PASSWORD=
REDIS_DIAL_LOCALHOST=false
