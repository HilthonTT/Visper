# Visper API configuration
#
# The API reads infrastructure/config/config-<env>.yml, where <env> comes from
# APP_ENV (development | docker | production; default: development). Every key
# in that file can be overridden with an environment variable named
# VISPER_<SECTION>_<KEY> (upper case, dots replaced by underscores).
# Secrets should be provided this way rather than committed to YAML.
#
# Values below are development defaults matching docker-compose.yml.

APP_ENV=docker

# Overrides server.externalPort (takes precedence over VISPER_SERVER_EXTERNALPORT)
# PORT=5005

# Server
# VISPER_SERVER_RUNMODE=release            # debug | release | production
# VISPER_SERVER_DOMAIN=localhost
# VISPER_SERVER_FRONTENDURL=http://localhost:3000

# CORS / websocket origins: comma separated list, or * for any origin
# VISPER_CORS_ALLOWORIGINS=http://localhost:3000

# Postgres
VISPER_POSTGRES_HOST=postgres
VISPER_POSTGRES_PORT=5432
VISPER_POSTGRES_USER=postgres
VISPER_POSTGRES_PASSWORD=admin
VISPER_POSTGRES_DBNAME=visper_db
# VISPER_POSTGRES_SSLMODE=disable

# Redis
VISPER_REDIS_HOST=redis
VISPER_REDIS_PORT=6379
VISPER_REDIS_PASSWORD=password
# VISPER_REDIS_DB=0

# Tracing: OTLP/HTTP endpoint (Jaeger accepts OTLP on :4318). A base URL gets
# /v1/traces appended; legacy http://host:14268/api/traces is mapped to :4318.
# VISPER_JAEGER_ENDPOINT=http://jaeger:4318

# Error reporting (leave empty to disable)
VISPER_SENTRY_DSN=
